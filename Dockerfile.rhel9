ARG GO_BUILDER=registry.ci.openshift.org/openshift/release:rhel-9-release-golang-1.26-openshift-5.0
ARG GO_RUNTIME=registry.access.redhat.com/ubi9/ubi-minimal@sha256:2d4c4551af6831dcd26bbf86108c4385de5183ec8fe6b5868f6f9640fe47f4ed

FROM $GO_BUILDER AS builder

WORKDIR /workspace
COPY . .

ENV CGO_ENABLED=1
ENV GOEXPERIMENT=strictfipsruntime
ENV GOFLAGS=''

RUN if [ -f /cachi2/cachi2.env ]; then . /cachi2/cachi2.env; fi && \
    go build -trimpath -tags strictfipsruntime -o /usr/bin/fkafka-runtime ./cmd/fkafka-runtime

FROM $GO_RUNTIME

COPY --from=builder /usr/bin/fkafka-runtime /usr/bin/fkafka-runtime
COPY LICENSE /licenses/

USER 65532

LABEL name="openshift-serverless-tech-preview/functions-adapter-kafka-rhel9" \
      com.redhat.component="openshift-serverless-functions-adapter-kafka-container" \
      version="2.0" \
      release="1" \
      summary="OpenShift Serverless Functions Kafka adapter" \
      description="Provides the Kafka runtime adapter for OpenShift Serverless Functions." \
      io.k8s.display-name="OpenShift Serverless Functions Kafka Adapter" \
      io.k8s.description="Provides the Kafka runtime adapter for OpenShift Serverless Functions." \
      io.openshift.tags="openshift,serverless,functions,kafka,adapter" \
      maintainer="serverless-support@redhat.com" \
      cpe="cpe:/a:redhat:openshift_serverless:2.0::el9"

ENTRYPOINT ["/usr/bin/fkafka-runtime"]
