{
  "extends": [
    "github>konflux-ci/mintmaker//config/renovate/renovate.json",
    "config:best-practices"
  ],
  "enabledManagers": ["tekton", "dockerfile", "rpm-lockfile"],
  "gomod": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "enabled": false,
      "matchPackageNames": [
        "/^registry\\.ci\\.openshift\\.org//"
      ]
    }
  ]
}
